WHITESPACE = _{ " " | "\t" | NEWLINE }

query = { SOI ~ algebra ~ EOI }

algebra = { from ~ (project | filter)* ~ into }

// Store identifiers
sql_identifier = { "SQL" }
mql_identifier = { "MQL" }
cypher_identifier = { "CYPHER" }
identifiers = _{ sql_identifier | mql_identifier | cypher_identifier }

/// Target type. Allows for the definition of a target of a valid format.
/// This can be fields, table / collections names etc.
/// A target can for example have the format `_users` or `something_0`
target = @{ "_"* ~ ASCII_ALPHA+ ~ ( ASCII_ALPHANUMERIC | "_" )* }

// Algebra operations

/// The into operation. Allows for the definition of where the algebraic operations should output to.
///
/// Example:
/// ```
/// INTO SQL(person)
/// ```
into = { "INTO" ~ identifiers ~ "(" ~ target ~ ")" }

/// The FROM operation. Allows for the defintion of where data, following algebraic operations operate on, should come from.
///
/// Example:
/// ```
/// FROM SQL(users)
/// ```
from = { "FROM" ~ identifiers ~ "(" ~ #target = target ~ ")" }

/// The project operation. Allows for the projection of data.
/// Can be escaped by the store identifiers (SQL, MQL, CYPHER)
/// Fields are specified by the name, seperated by commas
///
/// Example:
/// ```
/// PROJECT (name, age)
/// ```
project = { "PROJECT" ~ (escaper | "(" ~ target ~ ("," ~ target)* ~ ")" ) }

/// The filter operation. Allows for the filtering of data
///
/// Example:
/// ```
/// FILTER SQL(age > 25)
/// ```
filter = { "FILTER" ~ (escaper | expr) }

// Value Primitives

/// Integer type
integer = { '0'..'9'+ }

/// Float type
float = { integer ~ "." ~ integer }

/// Bool type
bool = { "TRUE" | "FALSE" }

/// Text type
text = { "\"" ~ (ASCII_ALPHA | WHITE_SPACE)* ~ "\""  }

number = { integer | float }
value = { integer | float | bool | text }

// Boolean operations
comparison = _{ le | leq | ge | geq | eq | neq }
le = { "<" }
leq = { "=<" }
ge = { ">" }
geq = { ">=" }
eq = { "==" }
neq = { "!=" }
and = { "AND" }
or = { "OR" }


// Math operations
math_primitive = _{ add | sub | div | mul }
add = { "+" }
sub = { "-" }
div = { "/" }
mul = { "*" }
op = { (number ~ math_primitive)+ ~ number }


expr = { " " }

// Escapers
// Allow for the definition of language based operations bypassing the normal hyperion-lang definitions
escaper = _{ sql | mql | cypher }

/// SQL escaper. Allows for the definition of raw SQL queries
///
/// Example:
/// ```
/// SQL(age > 25)
/// ```
sql = @{ sql_identifier ~ "(" ~ sql_content ~ ")" }
sql_content = _{ ( !("(" | ")") ~ ANY | "(" ~ sql_content ~ ")" )* }

/// MQL escaper. Allows for the definition of raw MQL queries
mql = @{ mql_identifier ~ "(" ~ mql_content ~ ")" }
mql_content = _{ ( !("{" | "}") ~ ANY | "{" ~ mql_content ~ "}" )* }

/// Cypher escaper. Allows for the definition of raw Cypher queries
cypher = @{ cypher_identifier ~ "(" ~ cypher_content ~ ")" }
cypher_content = _{ ( !("(" | ")") ~ ANY | "(" ~ sql_content ~ ")" )* }
